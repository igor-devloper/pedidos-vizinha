// datasource e generator você já deve ter, algo assim:

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Encomenda {
  id          String  @id @default(cuid())
  txid        String  @unique
  nome        String
  email       String
  telefone    String
  observacoes String?

  itens EncomendaItem[]

  totalItens Int
  valorTotal Decimal  @db.Decimal(10, 2)
  valorPago  Decimal? @db.Decimal(10, 2) // quanto o cliente declarou pagar (metade ou total)

  status            StatusEncomenda @default(AGUARDANDO_PAGAMENTO)
  comprovanteBase64 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Produto {
  id                          String           @id @default(cuid())
  slug                        String           @unique
  nome                        String
  descricao                   String
  preco                       Decimal          @db.Decimal(10, 2)
  precoConfeiteira            Decimal?         @db.Decimal(10, 2)
  quantidadeMinimaConfeiteira Int?
  ativoConfeiteira            Boolean          @default(false)
  imagemBase64                String
  categoria                   CategoriaProduto @default(CENTO)
  productTypeId               String?
  totalUnidades               Int              @default(100)
  maxTiposSalgado             Int              @default(5)
  permitePagamentoParcial     Boolean          @default(true)
  saboresSugeridos            String[]         @default([])
  comboItens                  Json             @default("[]")
  emPromocao                  Boolean          @default(false)
  descontoPercentual          Decimal          @default(0) @db.Decimal(5, 2)
  ativo                       Boolean          @default(true)
  antecedenciaMinimaHoras     Int?
  precisaSelecaoDeTipos       Boolean          @default(true)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  productType ProductType?    @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  pedidos     Pedido[]
  cupons      CupomDesconto[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model ProductType {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  minQuantity    Int?
  allowsMultiple Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Produto[]
}

model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  CartItem[]
  orders Order[]
}

model CartItem {
  id             String   @id @default(cuid())
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(10, 2)
  selectedItems  Json     @default("[]")
  requestedUnits Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Produto @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
}

model Order {
  id                        String          @id @default(cuid())
  status                    OrderStatus     @default(PENDING)
  mercadoPagoId             String?
  mercadoPagoPreferenceId   String?
  mercadoPagoInitPoint      String?
  mercadoPagoPaymentId      String?
  mercadoPagoStatusDetail   String?
  pixQrCode                 String?
  pixQrCodeBase64           String?
  pixExpirationDate         DateTime?
  saldoExternalReference    String?         @unique
  saldoPreferenceId         String?
  saldoPaymentId            String?
  saldoInitPoint            String?
  saldoTotalCobrado         Decimal?        @db.Decimal(10, 2)
  saldoPagoAt               DateTime?
  saldoCobrancaEnviadaAt    DateTime?
  externalReference         String          @unique
  customerName              String?
  customerEmail             String?
  customerPhone             String?
  totalAmount               Decimal         @db.Decimal(10, 2)
  paymentPercentage         Int             @default(100)
  paymentMethod             MetodoPagamento @default(PIX)
  paymentMethodLabel        String          @default("Pix")
  feePercent                Decimal         @default(0) @db.Decimal(5, 2)
  feeAmount                 Decimal         @default(0) @db.Decimal(10, 2)
  chargedAmount             Decimal         @default(0) @db.Decimal(10, 2)
  notificadoClienteAt       DateTime?
  raffleNotificadoAt        DateTime?
  notificadoVizinhaAt       DateTime?
  notificadoProntoClienteAt DateTime?
  prontoAt                  DateTime?
  impressoAutomaticamenteAt DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  code                      String?         @unique
  scheduledAt               DateTime?
  fulfillmentType           String          @default("PICKUP")
  deliveryAddress           String?
  deliveryReference         String?
  deliveryNeighborhood      String?
  deliveryCity              String?
  deliveryPlaceId           String?
  deliveryLatitude          Decimal?        @db.Decimal(10, 7)
  deliveryLongitude         Decimal?        @db.Decimal(10, 7)
  deliveryMapsUrl           String?
  deliveryFee               Decimal         @default(0) @db.Decimal(10, 2)
  deliveryFeeAgreed         Boolean         @default(true)
  provisionAmount           Decimal         @default(0) @db.Decimal(10, 2)
  provisionTransferredAt    DateTime?
  isConfeiteira             Boolean         @default(false)
  notifiedCourierAt         DateTime?
  notifiedCourierReadyAt    DateTime?
  source                    OrderSource     @default(SITE)

  cartId      String?
  cart        Cart?        @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  raffleEntry RaffleEntry?
  whatsappDraft WhatsappOrderDraft?
}

model WhatsappOrderDraft {
  id                    String    @id @default(cuid())
  instanceId            String
  remoteJid             String
  phone                 String
  customerName          String?
  customerEmail         String?
  stage                 String    @default("COLLECTING")
  status                String    @default("ACTIVE")
  fulfillmentType       String?
  scheduledAt           DateTime?
  deliveryStreet        String?
  deliveryNumber        String?
  deliveryNeighborhood  String?
  deliveryReference     String?
  paymentMethod         MetodoPagamento?
  paymentPercentage     Int?
  items                 Json      @default("[]")
  siteLinkSentAt        DateTime?
  whatsappOfferDueAt    DateTime?
  whatsappOfferSentAt   DateTime?
  siteOrderDetectedAt   DateTime?
  orderId               String?   @unique
  lastCustomerMessageAt DateTime?
  lastBotMessageAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([instanceId, remoteJid])
  @@index([status, whatsappOfferDueAt])
  @@index([phone, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  productName   String
  productType   String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
  selectedItems Json    @default("[]")

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Produto @relation(fields: [productId], references: [id], onDelete: Restrict)
}

/// Historico imutavel dos eventos relevantes de pedidos.
/// orderId e intencionalmente generico para auditar Order, Pedido e BotOrder
/// sem criar cascatas capazes de remover o historico.
model OrderEvent {
  id             String           @id @default(cuid())
  orderId        String
  event          OrderEventType
  previousStatus String?
  newStatus      String?
  source         OrderEventSource
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@index([orderId, createdAt])
  @@index([event, createdAt])
}

model CupomDesconto {
  id                 String   @id @default(cuid())
  codigo             String   @unique
  divulgadorNome     String
  divulgadorContato  String?
  descricao          String?
  descontoPercentual Decimal  @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  pedidos   Pedido[]
}

model BotFlow {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  instanceId String?
  gatilho    String
  resposta   String
  ativo      Boolean  @default(true)
  prioridade Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BotLead {
  id               String            @id @default(cuid())
  instanceId       String
  remoteJid        String
  pushName         String?
  phoneNumber      String?
  nome             String?
  menuCategoria    CategoriaProduto?
  horarioEntrega   String?
  stage            String            @default("new")
  status           String            @default("open")
  intent           String?
  eventoDetalhes   String?
  bairroRetirada   String?
  observacoes      String?
  lastInboundText  String?
  lastOutboundText String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([instanceId, remoteJid])
}

model BotOrder {
  id                  String           @id @default(cuid())
  code                String           @unique
  instanceId          String
  leadId              String?
  customerRemoteJid   String
  customerPhoneNumber String?
  customerName        String?
  menuCategoria       CategoriaProduto
  eventoDetalhes      String
  horarioEntrega      String
  observacoes         String?
  summary             String
  status              String           @default("PENDING_OWNER_APPROVAL")
  ownerReason         String?
  paymentStatus       String           @default("PENDING")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model EncomendaItem {
  id         String @id @default(cuid())
  tipo       String
  quantidade Int

  encomendaId String
  encomenda   Encomenda @relation(fields: [encomendaId], references: [id], onDelete: Cascade)
}

model Pedido {
  id                        String          @id @default(cuid())
  codigo                    String          @unique
  clienteNome               String
  clienteTelefone           String
  clienteEmail              String?
  observacoes               String?
  dataEntrega               DateTime
  percentualPagamento       Int
  metodoPagamento           MetodoPagamento
  metodoPagamentoLabel      String
  taxaPercentual            Decimal         @db.Decimal(5, 2)
  taxaValor                 Decimal         @db.Decimal(10, 2)
  subtotal                  Decimal         @db.Decimal(10, 2)
  totalCobrado              Decimal         @db.Decimal(10, 2)
  valorPago                 Decimal?        @db.Decimal(10, 2)
  descontoPercentual        Decimal         @default(0) @db.Decimal(5, 2)
  descontoValor             Decimal         @default(0) @db.Decimal(10, 2)
  cupomCodigoSnapshot       String?
  cupomDivulgadorSnapshot   String?
  totalUnidades             Int
  totalTipos                Int
  status                    PedidoStatus    @default(PENDENTE_PAGAMENTO)
  produtoNomeSnapshot       String
  produtoPrecoSnapshot      Decimal         @db.Decimal(10, 2)
  mpPreferenceId            String?
  mpPaymentId               String?
  mpMerchantOrderId         String?
  mpExternalReference       String          @unique
  mpInitPoint               String?
  saldoExternalReference    String?         @unique
  saldoPreferenceId         String?
  saldoInitPoint            String?
  saldoTotalCobrado         Decimal?        @db.Decimal(10, 2)
  saldoPagoAt               DateTime?
  saldoCobrancaEnviadaAt    DateTime?
  mpStatus                  String?
  mpStatusDetail            String?
  mpWebhookPayload          Json?
  notificadoClienteAt       DateTime?
  raffleNotificadoAt        DateTime?
  notificadoVizinhaAt       DateTime?
  prontoAt                  DateTime?
  notificadoProntoClienteAt DateTime?
  notificadoToleranciaAt    DateTime?
  impressoAutomaticamenteAt DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  provisionAmount           Decimal         @default(0) @db.Decimal(10, 2)
  provisionTransferredAt    DateTime?

  produtoId   String
  produto     Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  cupomId     String?
  cupom       CupomDesconto? @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  itens       PedidoItem[]
  raffleEntry RaffleEntry?
}

model RaffleEntry {
  id            String   @id @default(cuid())
  code          String   @unique
  customerName  String
  customerPhone String?
  createdAt     DateTime @default(now())

  orderId  String?      @unique
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pedidoId String?      @unique
  pedido   Pedido?      @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  draws    RaffleDraw[]
}

model RaffleDraw {
  id      String      @id @default(cuid())
  drawnAt DateTime    @default(now())
  entryId String
  entry   RaffleEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
}

model PedidoItem {
  id         String   @id @default(cuid())
  tipo       String
  quantidade Int
  createdAt  DateTime @default(now())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

// ============================================================
// StoreSettings - configurações dinâmicas da loja
// Há sempre exatamente 1 registro com id = "singleton".
// ============================================================
model StoreSettings {
  id                         String   @id @default("singleton")
  /// Loja aberta manualmente (true = aberta, false = fechada forçada)
  isOpen                     Boolean  @default(true)
  /// Horas mínimas de antecedência para pedidos (padrão: 2)
  minimumLeadHours           Int      @default(2)
  /// Permite mais de um pedido no mesmo horário de entrega.
  allowMultipleOrdersPerSlot Boolean  @default(false)
  operationSchedule          Json     @default("{}")
  siteTheme                  String   @default("PADRAO")
  featuredProductId          String?
  motorcycleCourierPhone     String?
  updatedAt                  DateTime @updatedAt
}

model WhatsappCampaign {
  id           String    @id @default(cuid())
  message      String
  delaySeconds Int       @default(15)
  status       String    @default("RUNNING")
  total        Int
  sent         Int       @default(0)
  failed       Int       @default(0)
  lastSentAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recipients WhatsappCampaignRecipient[]
}

model WhatsappCampaignRecipient {
  id        String    @id @default(cuid())
  phone     String
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  campaignId String
  campaign   WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
}

enum StatusEncomenda {
  AGUARDANDO_PAGAMENTO
  AGUARDANDO_VALIDACAO
  PAGO_METADE // meio pagamento confirmado
  CONFIRMADO // pagamento total confirmado
  CANCELADO
}

enum CategoriaProduto {
  CENTO
  LANCHONETE
  COMBO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
}

enum PedidoStatus {
  PENDENTE_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum OrderStatus {
  PENDING
  PAID
  READY
  DELIVERED
  CANCELLED
}

enum OrderSource {
  SITE
  WHATSAPP
  ADMIN
}

enum OrderEventType {
  ORDER_CREATED
  PAYMENT_CREATED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PAYMENT_CANCELLED
  ORDER_STATUS_CHANGED
  ORDER_READY
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_EDITED
  BOT_ORDER_CREATED
}

enum OrderEventSource {
  SITE
  WHATSAPP
  ADMIN
  MERCADO_PAGO
  SYSTEM
}
